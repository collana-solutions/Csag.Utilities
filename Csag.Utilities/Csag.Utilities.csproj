<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>3.0.0</Version>
    <Description>Extension methods and helpers for everyday .NET code: string truncation, padded StringBuilder lines, DateTime checks, CultureInfo language codes, IEnumerable helpers, strongly typed IConfiguration and IServiceCollection options binding, and human-readable file sizes.</Description>
    <PackageTags>utilities;extensions;helpers;configuration;options</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageReference Include="Csag.CodeAnalysis" Version="3.3.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
